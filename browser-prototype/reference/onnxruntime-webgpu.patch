+  body << "  for (var blk = lane; blk < uniforms.blocks_per_col; blk += " << kBlockLanes << "u) {\n";
+  for (uint32_t c = 0; c < kBlockCols; c++) {
+    body << "    let col" << c << " = min(col0 + " << c << "u, uniforms.N - 1u);\n"
+         << "    let q" << c << " = b[col" << c << " * uniforms.blocks_per_col + blk];\n"
+         << "    let s" << c << " = f32(scales[col" << c << " * uniforms.blocks_per_col + blk]);\n"
+         << "    let z" << c << " = zero(col" << c << ", blk);\n";
+  }
+  body << "    let sv = vec4<f32>(s0, s1, s2, s3);\n"
+          "    let zv = vec4<f32>(z0, z1, z2, z3);\n";
+  // Row r: its own copy of the same code. Word j of a block holds k = 8j .. 8j+7, element 2i in
+  // the low nibble of byte i.
+  for (uint32_t r = 0; r < kBlockRows; r++) {
+    body << "    if (rows > " << r << "u) {\n"
+         << "      let ab = a_base + " << r << "u * uniforms.K_of_a + blk * 8u;\n";
+    for (uint32_t j = 0; j < 4; j++) {
+      body << "      let x" << j << "0 = vec4<f32>(a[ab + " << 2 * j << "u]); let x" << j << "1 = vec4<f32>(a[ab + " << 2 * j + 1 << "u]);\n"
+           << "      let ae" << j << " = vec4<f32>(x" << j << "0.x, x" << j << "0.z, x" << j << "1.x, x" << j << "1.z);\n"
+           << "      let ao" << j << " = vec4<f32>(x" << j << "0.y, x" << j << "0.w, x" << j << "1.y, x" << j << "1.w);\n";
+    }
+    body << "      let sa = dot(ae0 + ae1 + ae2 + ae3 + ao0 + ao1 + ao2 + ao3, vec4<f32>(1.0));\n"
+         << "      let sums = vec4<f32>(";
+    for (uint32_t c = 0; c < kBlockCols; c++) {
