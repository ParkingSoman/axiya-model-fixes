+Status LinearAttentionDecodeProgram::GenerateShaderCode(ShaderHelper& shader) const {
+  shader.AddInput("query", ShaderUsage::UseUniform);
+  shader.AddInput("key", ShaderUsage::UseUniform);
+  shader.AddInput("value", ShaderUsage::UseUniform);  // vec4
