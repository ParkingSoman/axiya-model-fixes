@@ -0,0 +1,115 @@
+// Copyright (c) Microsoft Corporation. All rights reserved.
+// Licensed under the MIT License.
+
+// Batched MatMulNBits for small M (2 <= M <= 16), e.g. a speculative verify
+// pass. The M=1 program runs one workgroup per row, so M rows read and
+// dequantize all of B M times; the wide-tile program is built for prefill.
+// Here one workgroup computes all M rows for cols_per_thread * col_groups
+// output columns, and each weight word is read and dequantized once.
+//
+// Layout: the workgroup is col_groups groups of k_lanes threads. The lanes of
+// a group stride along K one u32 weight word at a time (consecutive lanes read
+// consecutive words, so reads coalesce) and each lane keeps tile_m x
+// cols_per_thread partial sums in registers. Lanes are then summed through
+// workgroup memory, one row at a time.
+//
+// Requirements (checked on the host): A has 4 components (K % 4 == 0), and
+// block_size is a multiple of the elements in one word (8 for 4 bits, 4 for 8).
+
+#param n_bits
+#param has_zero_points
+#param has_bias
+#param output_type_i32
+#param tile_m
+#param cols_per_thread
+#param col_groups
+#param k_lanes
+
+#use .getByOffset .setByOffset
+
+#include "quantization/matmul_nbits_zero_pt.wgsl.template"
+
+const cols_per_wg = cols_per_thread * col_groups;
+const elements_per_word = 32u / n_bits;
+
+var<workgroup> partials: array<array<output_element_t, k_lanes>, cols_per_wg>;
+
+$MAIN {
+  // A dispatch above 65535 workgroups is split into a 2-D grid that can hold
+  // more workgroups than asked for; the extra ones must not write.
+  if (workgroup_idx >= uniforms.num_N_tile * uniforms.batch_count) {
+    return;
+  }
+  let batch = workgroup_idx / uniforms.num_N_tile;
+  let n_base = (workgroup_idx % uniforms.num_N_tile) * cols_per_wg;
+  let lane = local_idx % k_lanes;
+  let group = local_idx / k_lanes;
+  let col0 = n_base + group * cols_per_thread;
+  let a_base = batch * uniforms.M * uniforms.K_of_a;
+
+  var acc: array<array<output_element_t, cols_per_thread>, tile_m>;
+
+  for (var w = lane; w < uniforms.words; w += k_lanes) {
+    let block_idx = (w * elements_per_word) / uniforms.block_size;
+#if n_bits == 4
+    // Word w holds k = 8w .. 8w+7: element 2j in the low nibble of byte j.
+    var b_lo: array<vec4<output_element_t>, cols_per_thread>;
+    var b_hi: array<vec4<output_element_t>, cols_per_thread>;
+    for (var c = 0u; c < cols_per_thread; c++) {
+      let col = min(col0 + c, uniforms.N - 1);
+      let q = b.getByOffset(col * uniforms.words + w);
+      let scale = scales_b.getByOffset(col * uniforms.blocks_per_col + block_idx);
+      let zero = mm_read_zero(col, block_idx, uniforms.N, uniforms.zero_blocks_per_col);
+      let lower = vec4<output_element_t>(unpack4xU8(q & 0x0F0F0F0Fu)) - vec4<output_element_t>(zero);
+      let upper = vec4<output_element_t>(unpack4xU8((q >> 4) & 0x0F0F0F0Fu)) - vec4<output_element_t>(zero);
+      b_lo[c] = vec4<output_element_t>(lower[0], upper[0], lower[1], upper[1]) * scale;
+      b_hi[c] = vec4<output_element_t>(lower[2], upper[2], lower[3], upper[3]) * scale;
+    }
+    for (var m = 0u; m < tile_m; m++) {
+      let a0 = a.getByOffset(a_base + m * uniforms.K_of_a + 2 * w);
+      let a1 = a.getByOffset(a_base + m * uniforms.K_of_a + 2 * w + 1);
+      for (var c = 0u; c < cols_per_thread; c++) {
+        acc[m][c] += dot(a0, b_lo[c]) + dot(a1, b_hi[c]);
+      }
+    }
+#elif n_bits == 8
+    // Word w holds k = 4w .. 4w+3, one byte each.
+    var bv: array<vec4<output_element_t>, cols_per_thread>;
+    for (var c = 0u; c < cols_per_thread; c++) {
+      let col = min(col0 + c, uniforms.N - 1);
+      let q = b.getByOffset(col * uniforms.words + w);
+      let scale = scales_b.getByOffset(col * uniforms.blocks_per_col + block_idx);
+      let zero = mm_read_zero(col, block_idx, uniforms.N, uniforms.zero_blocks_per_col);
+      bv[c] = (vec4<output_element_t>(unpack4xU8(q)) - vec4<output_element_t>(zero)) * scale;
+    }
+    for (var m = 0u; m < tile_m; m++) {
+      let a0 = a.getByOffset(a_base + m * uniforms.K_of_a + w);
+      for (var c = 0u; c < cols_per_thread; c++) {
+        acc[m][c] += dot(a0, bv[c]);
+      }
+    }
+#endif
+  }
+
+  // Sum the k_lanes partials of every (row, column), one row at a time.
+  for (var m = 0u; m < tile_m; m++) {
+    for (var c = 0u; c < cols_per_thread; c++) {
+      partials[group * cols_per_thread + c][lane] = acc[m][c];
+    }
+    workgroupBarrier();
+    if (local_idx < cols_per_wg) {
+      var sum = output_element_t(0);
+      for (var l = 0u; l < k_lanes; l++) {
+        sum += partials[local_idx][l];
+      }
+      let col = n_base + local_idx;
+      if (col < uniforms.N) {
+#if has_bias
+        sum += bias[col];
+#endif
+        output.setByOffset(batch * uniforms.M * uniforms.N + m * uniforms.N + col, sum);
+      }
+    }
+    workgroupBarrier();
+  }
+}  // MAIN
