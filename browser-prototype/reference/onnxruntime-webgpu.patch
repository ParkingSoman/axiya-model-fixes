--- /dev/null
+++ b/onnxruntime/contrib_ops/webgpu/bert/flash_attention_decode_gqa.wgsl.template
@@ -0,0 +1,170 @@
+// Copyright (c) Microsoft Corporation. All rights reserved.
+// Licensed under the MIT License.
+
+#param head_size_vec
+#param row_chunk
+#param tile_size
+#param use_seqlen_k
+
+#use .getByOffset .setByOffset
+
+// Multi-query GQA decode attention, split-K over the KV sequence (1 <= new
+// sequence length <= 16, e.g. one decode step or a speculative verify pass).
+//
+// One workgroup handles one (batch, KV head, KV tile of tile_size positions)
+// for every query row that reads that KV head: all new positions times all
+// n_reps query heads of the group. So each K/V tile is read from memory once
+// per pass, not once per query head and query tile.
+//
+// Each query row gets the same arithmetic for every new sequence length:
+//  - the KV split is fixed (tiles at multiples of tile_size from position 0);
+//  - a row reads only the keys it may see (causal end = past + s + 1), so a
+//    row of a k-token pass reads exactly the keys that a one-token pass at the
+//    same position reads, and no masked key is added in as zero;
+//  - every sum runs in a fixed order that depends on neither the row count
+//    nor the row's place in the workgroup;
+//  - the same pipeline runs for every row count (the count is a uniform).
+// So row s of a k-token pass has the same bits as a one-token pass at
+// position past + s. FlashAttentionDecodeGQAReduce then merges the tiles of
+// each row, in tile order.
+//
+// Per tile, per row: max and sum of exp (online softmax), the normalized
+// weights, and weights x V. Outputs: metadata (max, sum) and the partial
+// output, both float32, indexed by row = (batch * num_heads + q_head) *
+// new_sequence_length + s.
+
+const HV: u32 = head_size_vec;
+const RC: u32 = row_chunk;
+const T: u32 = tile_size;
+// Threads per key in the score phase, and rows per thread.
+const R_STRIDE: u32 = workgroup_size_x / T;
+const ROWS_PER_THREAD: u32 = RC / R_STRIDE;
+
+var<workgroup> q_sh: array<array<vec4<f32>, HV>, RC>;
+var<workgroup> s_sh: array<array<f32, T>, RC>;
+var<workgroup> cnt_sh: array<u32, RC>;
+var<workgroup> max_sh: array<f32, RC>;
+var<workgroup> sum_sh: array<f32, RC>;
+
+$MAIN {
+  let num_tiles = uniforms.num_tiles;
+  let tile_idx = workgroup_idx % num_tiles;
+  let batch_kv_head = workgroup_idx / num_tiles;
+  let kv_head = batch_kv_head % uniforms.kv_num_heads;
+  let batch = batch_kv_head / uniforms.kv_num_heads;
+  if (batch >= uniforms.batch_size) {
+    return;
+  }
+#if use_seqlen_k
+  let total = u32(seqlens_k[batch]) + 1u;
+#else
+  let total = uniforms.total_sequence_length;
+#endif
+  let tile_start = tile_idx * T;
+  if (tile_start >= total) {
+    return;
+  }
+  let S = uniforms.new_sequence_length;
+  let n_reps = uniforms.n_reps;
+  let past = select(total - S, 0u, total <= S);
+  let rows = S * n_reps;
+  // Row index of present_key/present_value (BNSH), in units of head_size_vec vec4s.
+  let kv_row_base = (batch * uniforms.kv_num_heads + kv_head) * uniforms.present_sequence_length;
+  let t_local = local_idx % T;
+  let r_sub = local_idx / T;
+
+  for (var chunk = 0u; chunk < rows; chunk += RC) {
+    // Load the chunk's query rows, scaled by alpha, and each row's key count
+    // in this tile.
+    for (var i = local_idx; i < RC * HV; i += workgroup_size_x) {
+      let rr = i / HV;
+      let d = i % HV;
+      let r = chunk + rr;
+      if (r < rows) {
+        let s = r / n_reps;
+        let q_head = kv_head * n_reps + r % n_reps;
+        let q_off = ((batch * S + s) * uniforms.num_heads + q_head) * HV + d;
+        q_sh[rr][d] = vec4<f32>(q.getByOffset(q_off)) * uniforms.alpha;
+      }
+    }
+    if (local_idx < RC) {
+      let r = chunk + local_idx;
+      var cnt = 0u;
+      if (r < rows) {
+        let valid_end = min(total, past + r / n_reps + 1u);
+        if (valid_end > tile_start) {
+          cnt = min(valid_end - tile_start, T);
+        }
+      }
+      cnt_sh[local_idx] = cnt;
+    }
+    workgroupBarrier();
+
+    // Scores: thread (t_local, r_sub) takes key t_local of the tile against
+    // rows r_sub, r_sub + R_STRIDE, ... Each score is one dot product summed
+    // over d = 0 .. HV-1 in order.
+    let key_pos = tile_start + t_local;
+    if (key_pos < total) {
+      var acc: array<f32, ROWS_PER_THREAD>;
+      for (var d = 0u; d < HV; d++) {
+        let k_vec = vec4<f32>(present_key.getByOffset((kv_row_base + key_pos) * HV + d));
+        for (var j = 0u; j < ROWS_PER_THREAD; j++) {
+          acc[j] += dot(k_vec, q_sh[r_sub + j * R_STRIDE][d]);
+        }
+      }
+      for (var j = 0u; j < ROWS_PER_THREAD; j++) {
+        s_sh[r_sub + j * R_STRIDE][t_local] = acc[j];
+      }
+    }
+    workgroupBarrier();
+
+    // Per row: max and sum of exp over the row's keys, in key order.
+    if (local_idx < RC) {
+      let cnt = cnt_sh[local_idx];
+      var m = f32(-3.4028234663852886e+38f);
+      for (var t = 0u; t < cnt; t++) {
+        m = max(m, s_sh[local_idx][t]);
+      }
+      var l = f32(0);
+      for (var t = 0u; t < cnt; t++) {
+        l += exp(s_sh[local_idx][t] - m);
+      }
+      max_sh[local_idx] = m;
+      sum_sh[local_idx] = l;
+      let r = chunk + local_idx;
+      if (cnt > 0u) {
+        let row = (batch * uniforms.num_heads + kv_head * n_reps + r % n_reps) * S + r / n_reps;
+        metadata.setByOffset(row * num_tiles + tile_idx, vec2<f32>(m, l));
+      }
+    }
+    workgroupBarrier();
+
+    // Normalized weights, in place.
+    for (var j = 0u; j < ROWS_PER_THREAD; j++) {
+      let rr = r_sub + j * R_STRIDE;
+      if (t_local < cnt_sh[rr]) {
+        s_sh[rr][t_local] = exp(s_sh[rr][t_local] - max_sh[rr]) / sum_sh[rr];
+      }
+    }
+    workgroupBarrier();
+
+    // Weights x V: one (row, vec4 of the head) per thread, summed over the
+    // row's keys in order.
+    for (var i = local_idx; i < RC * HV; i += workgroup_size_x) {
+      let rr = i / HV;
+      let d = i % HV;
+      let r = chunk + rr;
+      let cnt = cnt_sh[rr];
+      if (r < rows && cnt > 0u) {
+        var acc = vec4<f32>(0);
+        for (var t = 0u; t < cnt; t++) {
+          let v_vec = vec4<f32>(present_value.getByOffset((kv_row_base + tile_start + t) * HV + d));
+          acc += v_vec * s_sh[rr][t];
+        }
+        let row = (batch * uniforms.num_heads + kv_head * n_reps + r % n_reps) * S + r / n_reps;
+        partials.setByOffset((row * num_tiles + tile_idx) * HV + d, acc);
+      }
+    }
+    workgroupBarrier();
+  }
+}  // MAIN
