+Status FlashAttentionDecodeGQAProgram::GenerateShaderCode(ShaderHelper& shader) const {
+  const auto& q = shader.AddInput("q", ShaderUsage::UseUniform | ShaderUsage::UseValueTypeAlias);
+  const auto& present_key = shader.AddInput("present_key", ShaderUsage::UseUniform | ShaderUsage::UseValueTypeAlias);
+  const auto& present_value = shader.AddInput("present_value", ShaderUsage::UseUniform | ShaderUsage::UseValueTypeAlias);
+  if (use_seqlen_k_) {
+    shader.AddInput("seqlens_k", ShaderUsage::None);
+  }
+  const auto& partials = shader.AddOutput("partials", ShaderUsage::UseUniform | ShaderUsage::UseValueTypeAlias);
+  const auto& metadata = shader.AddOutput("metadata", ShaderUsage::UseUniform | ShaderUsage::UseValueTypeAlias);
+  ORT_ENFORCE(WorkgroupSizeX() % tile_size_ == 0 && row_chunk_ % (WorkgroupSizeX() / tile_size_) == 0,
+              "FlashAttentionDecodeGQA: workgroup size must be a multiple of tile_size, and row_chunk of their ratio.");
+  return WGSL_TEMPLATE_APPLY(shader, "bert/flash_attention_decode_gqa.wgsl.template",
+                             WGSL_TEMPLATE_PARAMETER(head_size_vec, head_size_vec_),
+                             WGSL_TEMPLATE_PARAMETER(row_chunk, row_chunk_),
+                             WGSL_TEMPLATE_PARAMETER(tile_size, tile_size_),
+                             WGSL_TEMPLATE_PARAMETER(use_seqlen_k, use_seqlen_k_),
+                             WGSL_TEMPLATE_VARIABLE(metadata, metadata),
+                             WGSL_TEMPLATE_VARIABLE(partials, partials),
+                             WGSL_TEMPLATE_VARIABLE(present_key, present_key),
+                             WGSL_TEMPLATE_VARIABLE(present_value, present_value),
+                             WGSL_TEMPLATE_VARIABLE(q, q));
+}
+
+Status FlashAttentionDecodeGQAReduceProgram::GenerateShaderCode(ShaderHelper& shader) const {
+  const auto& partials = shader.AddInput("partials", ShaderUsage::UseUniform | ShaderUsage::UseValueTypeAlias);
+  const auto& metadata = shader.AddInput("metadata", ShaderUsage::UseUniform | ShaderUsage::UseValueTypeAlias);
+  if (use_seqlen_k_) {
+    shader.AddInput("seqlens_k", ShaderUsage::None);
+  }
