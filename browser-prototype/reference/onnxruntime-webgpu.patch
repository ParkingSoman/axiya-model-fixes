+  const uint32_t output_count = static_cast<uint32_t>(rows) * head_size_vec;
+  FlashAttentionDecodeGQAReduceProgram reduce{tile_size, use_seqlen_k};
+  reduce.AddInputs({{&partials, ProgramTensorMetadataDependency::Rank, 4},
+                    {&metadata, ProgramTensorMetadataDependency::Rank, 2}});
+  if (use_seqlen_k) {
+    reduce.AddInput({seqlen_k, ProgramTensorMetadataDependency::None});
+  }
+  reduce.AddOutput({output, ProgramTensorMetadataDependency::TypeAndRank, 4});
