+          "    }\n"
+          "  }\n"
+          "}\n";
+  auto& body = shader.MainFunctionBody();
+  body << "  let tiles = uniforms.num_N_tile * uniforms.num_M_tile;\n"
+          "  if (workgroup_idx >= tiles * uniforms.batch_count) { return; }\n"
+          "  let batch = workgroup_idx / tiles;\n"
+          "  let m_tile = (workgroup_idx % tiles) / uniforms.num_N_tile;\n"
+          "  let n_base = (workgroup_idx % uniforms.num_N_tile) * cols_per_wg;\n"
+          "  let row0 = m_tile * uniforms.rows_per_tile;\n"
+          "  let rows = min(uniforms.rows_per_tile, uniforms.M - row0);\n"
