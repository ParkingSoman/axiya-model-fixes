+Status MatMulNBitsBlockProgram::GenerateShaderCode(ShaderHelper& shader) const {
+  shader.AddInput("a", ShaderUsage::UseUniform);       // vec4<f32>
+  shader.AddInput("b", ShaderUsage::UseUniform);       // vec4<u32>: one 32-value block
+  shader.AddInput("scales", ShaderUsage::UseUniform);  // f32
