@@ -0,0 +1,56 @@
+// Copyright (c) Microsoft Corporation. All rights reserved.
+// Licensed under the MIT License.
+
+#param tile_size
+#param use_seqlen_k
+
+#use .getByOffset .setByOffset
+
+// Merges the per-tile results of FlashAttentionDecodeGQA. One thread per
+// (row, vec4 of the head). A row reads only its own tiles (those that hold a
+// key it may see), in tile order, so its result does not depend on the new
+// sequence length:
+//
+//   g_max  = max over tiles of m_i
+//   g_sum  = sum over tiles of l_i * exp(m_i - g_max)
+//   out[d] = sum over tiles of partial_i[d] * (l_i * exp(m_i - g_max) / g_sum)
+
+$MAIN {
+  if (global_idx >= uniforms.output_count) {
+    return;
+  }
+  let HV = uniforms.head_size_vec;
+  let S = uniforms.new_sequence_length;
+  let num_tiles = uniforms.num_tiles;
+  let d = global_idx % HV;
+  let row = global_idx / HV;
+  let s = row % S;
+  let batch_head = row / S;
+  let q_head = batch_head % uniforms.num_heads;
+  let batch = batch_head / uniforms.num_heads;
+#if use_seqlen_k
+  let total = u32(seqlens_k[batch]) + 1u;
+#else
+  let total = uniforms.total_sequence_length;
+#endif
+  let past = select(total - S, 0u, total <= S);
+  let valid_end = min(total, past + s + 1u);
+  let n = (valid_end + tile_size - 1u) / tile_size;
+  let meta_base = row * num_tiles;
+
+  var g_max = f32(-3.4028234663852886e+38f);
+  for (var i = 0u; i < n; i++) {
+    g_max = max(g_max, metadata.getByOffset(meta_base + i).x);
+  }
+  var g_sum = f32(0);
+  for (var i = 0u; i < n; i++) {
+    let m = metadata.getByOffset(meta_base + i);
+    g_sum += m.y * exp(m.x - g_max);
+  }
+  var acc = vec4<f32>(0);
+  for (var i = 0u; i < n; i++) {
+    let m = metadata.getByOffset(meta_base + i);
+    acc += partials.getByOffset((meta_base + i) * HV + d) * (m.y * exp(m.x - g_max) / g_sum);
+  }
+  output.setByOffset(((batch * S + s) * uniforms.num_heads + q_head) * HV + d, output_value_t(acc));
+}  // MAIN
