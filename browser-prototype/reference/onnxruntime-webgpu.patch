+  } else {
+    b << "  let past_slot = 0u;\n";
+  }
+  b << "  var s: array<vec4<f32>, 8>;  // [row r][column j] at r * 2 + j, row k = t + 32 r\n";
+  b << "  for (var r = 0u; r < 4u; r++) {\n"
+       "    let base = past_slot + (bh * D + t + 32u * r) * D4 + col4;\n";
