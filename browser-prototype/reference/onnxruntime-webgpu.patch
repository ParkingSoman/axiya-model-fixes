+// =============================================================================
+// ORT fork (ovis): chunked gated-delta-rule prefill (see linear_attention.h)
+// =============================================================================
+// Chunk length C and the record layout shared by the two passes. One chunk record (index
+// bh * num_chunks + chunk) holds W (C x 128), U (C x 128), P (C x C) and the decay factors
+// G (kChunkG floats: C query factors scale*exp(gc_t), C key factors exp(gc_last - gc_s), then
+// exp(gc_last)). Every exponent is <= 0 (decay is log-space and <= 0; gc is its running sum).
+constexpr uint32_t kChunk = 16;
+constexpr uint32_t kChunkHead = 128;  // d_k = d_v the chunked path supports
+constexpr uint32_t kChunkG = 2 * kChunk + 4;
+constexpr uint32_t kChunkPG = kChunk * kChunk + kChunkG;  // P and G share one buffer (8 storage buffers max)
+constexpr uint32_t kChunkTileV = 16;  // value columns per scan workgroup (4 x vec4)
+
+Status LinearAttentionChunkPrepProgram::GenerateShaderCode(ShaderHelper& shader) const {
+  shader.AddInput("query", ShaderUsage::UseUniform);
+  shader.AddInput("key", ShaderUsage::UseUniform);
+  shader.AddInput("value", ShaderUsage::UseUniform);
+  shader.AddInput("decay", ShaderUsage::UseUniform);
+  shader.AddInput("beta", ShaderUsage::UseUniform);
+  shader.AddOutput("wbuf", ShaderUsage::UseUniform);
+  shader.AddOutput("ubuf", ShaderUsage::UseUniform);
+  shader.AddOutput("pgbuf", ShaderUsage::UseUniform);
+  shader.AdditionalImplementation()
+      << "const C: u32 = " << kChunk << "u;\n"
+      << "const D: u32 = " << kChunkHead << "u;\n"
+      << "const PG: u32 = " << kChunkPG << "u;\n"
+      << "var<workgroup> ks: array<f32, " << kChunk * kChunkHead << ">;\n"
+         "var<workgroup> gc: array<f32, C>;\n"
+         "var<workgroup> bs: array<f32, C>;\n"
+         "var<workgroup> am: array<f32, C * C>;\n"
+         "var<workgroup> tm: array<f32, C * C>;\n";
+  shader.MainFunctionBody() << R"WGSL(
+  let rec = workgroup_idx;
+  let bh = rec / uniforms.num_chunks;
+  let chunk = rec % uniforms.num_chunks;
+  let H = uniforms.num_heads;
+  let b = bh / H;
+  let h = bh % H;
+  let t0 = chunk * C;
+  let n = min(C, uniforms.prefix_length - t0);
+  let i = local_idx;
+  // Keys of the chunk (rows >= n are zero), running decay sum and betas.
+  for (var s = 0u; s < C; s++) {
+    var kv = 0.0;
+    if (s < n) {
+      kv = f32(key[((b * uniforms.seq_length + t0 + s) * H + h) * D + i]);
+    }
+    ks[s * D + i] = kv;
+  }
+  if (i == 0u) {
+    var acc = 0.0;
+    for (var s = 0u; s < C; s++) {
+      var gv = 0.0;
+      var bv = 0.0;
+      if (s < n) {
+        let idx = (b * uniforms.seq_length + t0 + s) * H + h;
+        gv = f32(decay[idx]);
+        bv = f32(beta[idx]);
+      }
+      acc += gv;
+      gc[s] = acc;
+      bs[s] = bv;
+    }
+  }
+  workgroupBarrier();
+  // A[t][s] (s < t) and P[t][s] (s <= t); the dot loops start at different offsets per job so
+  // that neighbouring jobs read different workgroup-memory banks.
+  for (var job = i; job < C * C; job += workgroup_size_x) {
+    let t = job / C;
+    let s = job % C;
+    var a = 0.0;
+    if (s < t) {
+      var d = 0.0;
+      for (var x = 0u; x < D; x++) {
+        let xx = (x + job) % D;
+        d += ks[t * D + xx] * ks[s * D + xx];
+      }
+      a = bs[t] * exp(gc[t] - gc[s]) * d;
+    }
+    am[job] = a;
+    var p = 0.0;
+    if (s <= t && t < n) {
+      let qb = ((b * uniforms.seq_length + t0 + t) * H + h) * D;
+      var d = 0.0;
+      for (var x = 0u; x < D; x++) {
+        let xx = (x + job) % D;
+        d += f32(query[qb + xx]) * ks[s * D + xx];
+      }
+      p = uniforms.scale * exp(gc[t] - gc[s]) * d;
+    }
+    pgbuf[rec * PG + job] = p;
+    tm[job] = select(0.0, 1.0, t == s);
+  }
+  workgroupBarrier();
+  // T = (I + A)^-1 (unit lower triangular), one row after another.
+  for (var t = 1u; t < C; t++) {
+    if (i < t) {
+      var acc = 0.0;
+      for (var m = i; m < t; m++) {
+        acc -= am[t * C + m] * tm[m * C + i];
+      }
+      tm[t * C + i] = acc;
+    }
+    workgroupBarrier();
+  }
+  // Column i of W = T diag(beta exp(gc)) K and U = T diag(beta) V.
+  var w: array<f32, C>;
+  var u: array<f32, C>;
+  for (var c = 0u; c < C; c++) {
+    w[c] = 0.0;
+    u[c] = 0.0;
+  }
+  for (var s = 0u; s < C; s++) {
+    var vv = 0.0;
+    if (s < n) {
+      vv = f32(value[((b * uniforms.seq_length + t0 + s) * H + h) * D + i]);
+    }
+    let kval = ks[s * D + i] * bs[s] * exp(gc[s]);
+    let vval = vv * bs[s];
+    for (var c = 0u; c < C; c++) {
+      let tcs = tm[c * C + s];
+      w[c] += tcs * kval;
+      u[c] += tcs * vval;
+    }
+  }
+  for (var c = 0u; c < C; c++) {
+    wbuf[(rec * C + c) * D + i] = w[c];
+    ubuf[(rec * C + c) * D + i] = u[c];
+  }
+  if (i < C) {
+    let gl = gc[n - 1u];
+    pgbuf[rec * PG + C * C + i] = uniforms.scale * exp(gc[i]);
+    pgbuf[rec * PG + C * C + C + i] = select(0.0, exp(gl - gc[i]), i < n);
+    if (i == 0u) {
+      pgbuf[rec * PG + C * C + 2u * C] = exp(gl);
+    }
+  }
+)WGSL";
+  return Status::OK();
+}
