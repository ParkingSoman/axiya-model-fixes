+  const uint32_t B = static_cast<uint32_t>(parameters.batch_size_);
+  const uint32_t num_heads = static_cast<uint32_t>(parameters.num_heads_);
+  const uint32_t kv_num_heads = static_cast<uint32_t>(parameters.kv_num_heads_);
+  const uint32_t n_reps = static_cast<uint32_t>(parameters.n_reps);
