+  const uint32_t cols_per_wg = kBlockCols * kBlockGroups;
+  const uint32_t threads = kBlockLanes * kBlockGroups;
+  auto& impl = shader.AdditionalImplementation();
+  impl << "const cols_per_wg = " << cols_per_wg << "u;\n"
+       << "var<workgroup> partials: array<array<f32, " << kBlockLanes << ">, " << kBlockRows * cols_per_wg << ">;\n";
+  if (has_zero_points_) {
+    impl << "fn zero(col: u32, blk: u32) -> f32 { let off = col * uniforms.zero_blocks_per_col + blk; "
+            "return f32((zero_points[off / 8u] >> ((off % 8u) * 4u)) & 0xFu); }\n";
+  } else {
+    impl << "fn zero(col: u32, blk: u32) -> f32 { return 8.0; }\n";
+  }
+  impl << "fn store_row(r: u32, group: u32, lane: u32, acc: vec4<f32>) {\n"
+          "  let slot = r * cols_per_wg + group * 4u;\n"
+          "  partials[slot][lane] = acc.x; partials[slot + 1u][lane] = acc.y; partials[slot + 2u][lane] = acc.z; partials[slot + 3u][lane] = acc.w;\n"
+          "}\n"
+          "fn reduce_phase(batch: u32, row0: u32, rows: u32, n_base: u32, lidx: u32) {\n"
+          "  for (var t = lidx; t < " << kBlockRows * cols_per_wg << "u; t += " << threads << "u) {\n"
+          "    let r = t / cols_per_wg; let col = n_base + t % cols_per_wg;\n"
+          "    if (r < rows && col < uniforms.N) {\n"
+          "      var v = 0.0;\n"
+          "      for (var l = 0u; l < " << kBlockLanes << "u; l++) { v += partials[t][l]; }\n";
