+// accumulators are separate variables (vec4, one component per column of the
+// thread), so they stay in registers: an accumulator array indexed by a
+// runtime row loop was kept in memory and cost almost a full weight pass per
+// extra row on the M5. Row m's step sits inside row m - 1's branch, so a
+// one-row step tests one condition per B word (16 flat branches made M = 1
+// about 10 % slower than this).
+//
+// Requirements (checked on the host): A has 4 components (K % 4 == 0), K is a
+// multiple of block_size, block_size a multiple of 32 / n_bits, n_bits 4 or 8,
+// tile_rows 16, reduce_rows 4, cols_per_thread 4.
+
+#param n_bits
+#param has_zero_points
+#param has_bias
+#param output_type_i32
+#param reduce_rows
+#param cols_per_thread
+#param col_groups
+#param k_lanes
+
+#use .getByOffset .setByOffset
+
+#include "quantization/matmul_nbits_zero_pt.wgsl.template"
+
+const cols_per_wg = cols_per_thread * col_groups;
+const wg_threads = col_groups * k_lanes;
+const elements_per_word = 32u / n_bits;
+
+alias acc_t = vec4<output_element_t>;
+
+// Lane sums for the final reduction: [row of the phase][column slot][lane].
+var<workgroup> partials: array<array<output_element_t, k_lanes>, reduce_rows * cols_per_wg>;
+
+#if n_bits == 4
+// One row's four column sums for B word w (k = 8w .. 8w+7).
+fn row_sums(a_row : u32, w : u32, b_lo : array<acc_t, 4>, b_hi : array<acc_t, 4>) -> acc_t {
+  let a0 = a.getByOffset(a_row + 2 * w);
+  let a1 = a.getByOffset(a_row + 2 * w + 1);
+  return acc_t(dot(a0, b_lo[0]) + dot(a1, b_hi[0]),
+               dot(a0, b_lo[1]) + dot(a1, b_hi[1]),
+               dot(a0, b_lo[2]) + dot(a1, b_hi[2]),
+               dot(a0, b_lo[3]) + dot(a1, b_hi[3]));
+}
+#else
+// One row's four column sums for B word w (k = 4w .. 4w+3).
+fn row_sums(a_row : u32, w : u32, bv : array<acc_t, 4>) -> acc_t {
+  let a0 = a.getByOffset(a_row + w);
+  return acc_t(dot(a0, bv[0]), dot(a0, bv[1]), dot(a0, bv[2]), dot(a0, bv[3]));
+}
+#endif
+
+// Row r (of the phase) lane sums of this thread's four columns.
+fn store_row(r : u32, group : u32, lane : u32, acc : acc_t) {
+  let slot = r * cols_per_wg + group * cols_per_thread;
+  partials[slot][lane] = acc[0];
+  partials[slot + 1][lane] = acc[1];
+  partials[slot + 2][lane] = acc[2];
+  partials[slot + 3][lane] = acc[3];
+}
+
+// Sums the lane sums of rows mb .. mb + reduce_rows - 1 in lane order and
+// writes them.
+fn reduce_phase(batch : u32, row0 : u32, mb : u32, rows : u32, n_base : u32, local_idx : u32) {
+  for (var t = local_idx; t < reduce_rows * cols_per_wg; t += wg_threads) {
+    let r = t / cols_per_wg;
+    let col = n_base + t % cols_per_wg;
+    if (mb + r < rows && col < uniforms.N) {
+      var output_value = output_element_t(0);
+      for (var l = 0u; l < k_lanes; l++) {
+        output_value += partials[t][l];
+      }
+#if has_bias
+      output_value += bias[col];
+#endif
+      output.setByOffset(batch * uniforms.M * uniforms.N + (row0 + mb + r) * uniforms.N + col, output_value);
+    }
+  }
+}
+
+$MAIN {
+  // A dispatch above 65535 workgroups is split into a 2-D grid that can hold
+  // more workgroups than asked for; the extra ones must not write.
+  let tiles_per_batch = uniforms.num_N_tile * uniforms.num_M_tile;
+  if (workgroup_idx >= tiles_per_batch * uniforms.batch_count) {
+    return;
+  }
+  let batch = workgroup_idx / tiles_per_batch;
+  let m_tile = (workgroup_idx % tiles_per_batch) / uniforms.num_N_tile;
+  let n_base = (workgroup_idx % uniforms.num_N_tile) * cols_per_wg;
+  let row0 = m_tile * uniforms.rows_per_tile;
+  let rows = min(uniforms.rows_per_tile, uniforms.M - row0);
+  // Consecutive threads take consecutive K lanes of one column group, so they
+  // read consecutive B words and consecutive A values.
+  let lane = local_idx % k_lanes;
+  let group = local_idx / k_lanes;
+  let col0 = n_base + group * cols_per_thread;
+  let a_base = batch * uniforms.M * uniforms.K_of_a + row0 * uniforms.K_of_a;
+  let K_of_a = uniforms.K_of_a;
+
+  var acc0 = acc_t(0);
+  var acc1 = acc_t(0);
+  var acc2 = acc_t(0);
+  var acc3 = acc_t(0);
+  var acc4 = acc_t(0);
+  var acc5 = acc_t(0);
+  var acc6 = acc_t(0);
+  var acc7 = acc_t(0);
+  var acc8 = acc_t(0);
+  var acc9 = acc_t(0);
+  var acc10 = acc_t(0);
+  var acc11 = acc_t(0);
+  var acc12 = acc_t(0);
+  var acc13 = acc_t(0);
+  var acc14 = acc_t(0);
+  var acc15 = acc_t(0);
+
+  for (var w = lane; w < uniforms.words; w += k_lanes) {
+    let block_idx = (w * elements_per_word) / uniforms.block_size;
+#if n_bits == 4
+    // Word w holds k = 8w .. 8w+7: element 2j in the low nibble of byte j.
+    var b_lo: array<acc_t, 4>;
+    var b_hi: array<acc_t, 4>;
+    for (var c = 0u; c < cols_per_thread; c++) {
+      let col = min(col0 + c, uniforms.N - 1);
+      let q = b.getByOffset(col * uniforms.words + w);
+      let scale = scales_b.getByOffset(col * uniforms.blocks_per_col + block_idx);
+      let zero = mm_read_zero(col, block_idx, uniforms.N, uniforms.zero_blocks_per_col);
+      let lower = vec4<output_element_t>(unpack4xU8(q & 0x0F0F0F0Fu)) - vec4<output_element_t>(zero);
+      let upper = vec4<output_element_t>(unpack4xU8((q >> 4) & 0x0F0F0F0Fu)) - vec4<output_element_t>(zero);
+      b_lo[c] = vec4<output_element_t>(lower[0], upper[0], lower[1], upper[1]) * scale;
+      b_hi[c] = vec4<output_element_t>(lower[2], upper[2], lower[3], upper[3]) * scale;
+    }
+#else
+    // Word w holds k = 4w .. 4w+3, one byte each.
+    var bv: array<acc_t, 4>;
+    for (var c = 0u; c < cols_per_thread; c++) {
+      let col = min(col0 + c, uniforms.N - 1);
+      let q = b.getByOffset(col * uniforms.words + w);
+      let scale = scales_b.getByOffset(col * uniforms.blocks_per_col + block_idx);
+      let zero = mm_read_zero(col, block_idx, uniforms.N, uniforms.zero_blocks_per_col);
+      bv[c] = (vec4<output_element_t>(unpack4xU8(q)) - vec4<output_element_t>(zero)) * scale;
+    }
+#endif
+    // Every row: the same call, with its own A offset and accumulator.
+#if n_bits == 4
+    if (rows > 0u) {
+      acc0 += row_sums(a_base + 0u * K_of_a, w, b_lo, b_hi);
+      if (rows > 1u) {
+        acc1 += row_sums(a_base + 1u * K_of_a, w, b_lo, b_hi);
+        if (rows > 2u) {
+          acc2 += row_sums(a_base + 2u * K_of_a, w, b_lo, b_hi);
+          if (rows > 3u) {
+            acc3 += row_sums(a_base + 3u * K_of_a, w, b_lo, b_hi);
+            if (rows > 4u) {
+              acc4 += row_sums(a_base + 4u * K_of_a, w, b_lo, b_hi);
+              if (rows > 5u) {
+                acc5 += row_sums(a_base + 5u * K_of_a, w, b_lo, b_hi);
+                if (rows > 6u) {
+                  acc6 += row_sums(a_base + 6u * K_of_a, w, b_lo, b_hi);
+                  if (rows > 7u) {
+                    acc7 += row_sums(a_base + 7u * K_of_a, w, b_lo, b_hi);
+                    if (rows > 8u) {
+                      acc8 += row_sums(a_base + 8u * K_of_a, w, b_lo, b_hi);
+                      if (rows > 9u) {
+                        acc9 += row_sums(a_base + 9u * K_of_a, w, b_lo, b_hi);
+                        if (rows > 10u) {
+                          acc10 += row_sums(a_base + 10u * K_of_a, w, b_lo, b_hi);
+                          if (rows > 11u) {
+                            acc11 += row_sums(a_base + 11u * K_of_a, w, b_lo, b_hi);
+                            if (rows > 12u) {
+                              acc12 += row_sums(a_base + 12u * K_of_a, w, b_lo, b_hi);
+                              if (rows > 13u) {
+                                acc13 += row_sums(a_base + 13u * K_of_a, w, b_lo, b_hi);
+                                if (rows > 14u) {
+                                  acc14 += row_sums(a_base + 14u * K_of_a, w, b_lo, b_hi);
+                                  if (rows > 15u) {
+                                    acc15 += row_sums(a_base + 15u * K_of_a, w, b_lo, b_hi);
+                                  }
+                                }
+                              }
+                            }
+                          }
+                        }
+                      }
+                    }
+                  }
+                }
+              }
+            }
+          }
+        }
+      }
+    }
+#else
+    if (rows > 0u) {
+      acc0 += row_sums(a_base + 0u * K_of_a, w, bv);
+      if (rows > 1u) {
+        acc1 += row_sums(a_base + 1u * K_of_a, w, bv);
+        if (rows > 2u) {
+          acc2 += row_sums(a_base + 2u * K_of_a, w, bv);
+          if (rows > 3u) {
+            acc3 += row_sums(a_base + 3u * K_of_a, w, bv);
+            if (rows > 4u) {
+              acc4 += row_sums(a_base + 4u * K_of_a, w, bv);
+              if (rows > 5u) {
+                acc5 += row_sums(a_base + 5u * K_of_a, w, bv);
+                if (rows > 6u) {
+                  acc6 += row_sums(a_base + 6u * K_of_a, w, bv);
+                  if (rows > 7u) {
+                    acc7 += row_sums(a_base + 7u * K_of_a, w, bv);
+                    if (rows > 8u) {
+                      acc8 += row_sums(a_base + 8u * K_of_a, w, bv);
+                      if (rows > 9u) {
+                        acc9 += row_sums(a_base + 9u * K_of_a, w, bv);
+                        if (rows > 10u) {
+                          acc10 += row_sums(a_base + 10u * K_of_a, w, bv);
+                          if (rows > 11u) {
+                            acc11 += row_sums(a_base + 11u * K_of_a, w, bv);
+                            if (rows > 12u) {
+                              acc12 += row_sums(a_base + 12u * K_of_a, w, bv);
+                              if (rows > 13u) {
+                                acc13 += row_sums(a_base + 13u * K_of_a, w, bv);
+                                if (rows > 14u) {
+                                  acc14 += row_sums(a_base + 14u * K_of_a, w, bv);
+                                  if (rows > 15u) {
+                                    acc15 += row_sums(a_base + 15u * K_of_a, w, bv);
+                                  }
+                                }
+                              }
+                            }
+                          }
+                        }
+                      }
+                    }
+                  }
+                }
+              }
+            }
+          }
+        }
+      }
+    }
+#endif
+  }
+
+  // Sum the k_lanes lane sums of every (row, column) in lane order,
+  // reduce_rows rows at a time.
+  if (rows > 0u) { store_row(0u, group, lane, acc0); }
+  if (rows > 1u) { store_row(1u, group, lane, acc1); }
+  if (rows > 2u) { store_row(2u, group, lane, acc2); }
+  if (rows > 3u) { store_row(3u, group, lane, acc3); }
+  workgroupBarrier();
+  reduce_phase(batch, row0, 0u, rows, n_base, local_idx);
+  workgroupBarrier();
+  if (rows > 4u) {
+    store_row(0u, group, lane, acc4);
+    if (rows > 5u) { store_row(1u, group, lane, acc5); }
+    if (rows > 6u) { store_row(2u, group, lane, acc6); }
+    if (rows > 7u) { store_row(3u, group, lane, acc7); }
+    workgroupBarrier();
+    reduce_phase(batch, row0, 4u, rows, n_base, local_idx);
+    workgroupBarrier();
+  }
+  if (rows > 8u) {
+    store_row(0u, group, lane, acc8);
+    if (rows > 9u) { store_row(1u, group, lane, acc9); }
+    if (rows > 10u) { store_row(2u, group, lane, acc10); }
+    if (rows > 11u) { store_row(3u, group, lane, acc11); }
+    workgroupBarrier();
+    reduce_phase(batch, row0, 8u, rows, n_base, local_idx);
+    workgroupBarrier();
+  }
+  if (rows > 12u) {
+    store_row(0u, group, lane, acc12);
+    if (rows > 13u) { store_row(1u, group, lane, acc13); }
+    if (rows > 14u) { store_row(2u, group, lane, acc14); }
+    if (rows > 15u) { store_row(3u, group, lane, acc15); }
+    workgroupBarrier();
+    reduce_phase(batch, row0, 12u, rows, n_base, local_idx);
+  }
+}  // MAIN
