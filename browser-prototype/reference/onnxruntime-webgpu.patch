+         "    for (var sl = 0u; sl < uniforms.state_window - uniforms.seq_length; sl++) {\n"
+         "      for (var r = 0u; r < 4u; r++) {\n"
+         "        let base = sl * slot_size + (bh * D + t + 32u * r) * D4 + col4;\n"
+         "        present_state[base] = present_state_value_t(0.0); present_state[base + 1u] = present_state_value_t(0.0);\n"
+         "      }\n"
+         "    }\n"
+         "  }\n";
+  } else {
+    b << "  for (var r = 0u; r < 4u; r++) {\n"
+         "    let base = (bh * D + t + 32u * r) * D4 + col4;\n"
+         "    present_state[base] = present_state_value_t(s[r * 2u]); present_state[base + 1u] = present_state_value_t(s[r * 2u + 1u]);\n"
+         "  }\n";
+  }
+  return Status::OK();
