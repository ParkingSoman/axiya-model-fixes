diff --git a/onnxruntime/contrib_ops/webgpu/bert/split_masked_softmax.cc b/onnxruntime/contrib_ops/webgpu/bert/split_masked_softmax.cc
new file mode 100644
index 0000000..4cc041e
--- /dev/null
+++ b/onnxruntime/contrib_ops/webgpu/bert/split_masked_softmax.cc
@@ -0,0 +1,215 @@
+// Copyright (c) Microsoft Corporation. All rights reserved.
+// Licensed under the MIT License.
+
+#include <string>
+
+#include "core/providers/webgpu/shader_helper.h"
+#include "core/providers/webgpu/webgpu_utils.h"
+#include "core/providers/webgpu/webgpu_supported_types.h"
+#include "contrib_ops/webgpu/bert/split_masked_softmax.h"
+#include "contrib_ops/webgpu/webgpu_contrib_kernels.h"
+
+namespace onnxruntime {
+namespace contrib {
+namespace webgpu {
+
+ONNX_OPERATOR_KERNEL_EX(
+    SplitMaskedSoftmax,
+    kMSDomain,
+    1,
+    kWebGpuExecutionProvider,
+    (*KernelDefBuilder::Create())
+        .TypeConstraint("T", DataTypeImpl::GetTensorType<float>())
+        .TypeConstraint("U", DataTypeImpl::GetTensorType<MLFloat16>()),
+    SplitMaskedSoftmax);
+
+namespace {
+std::string VecType(int components) {
+  return components == 1 ? std::string{"f32"} : "vec" + std::to_string(components) + "<f32>";
+}
+std::string MaxOf(const std::string& v, int components) {
+  switch (components) {
+    case 1:
+      return v;
+    case 2:
+      return "max(" + v + ".x, " + v + ".y)";
+    default:
+      return "max(max(" + v + ".x, " + v + ".y), max(" + v + ".z, " + v + ".w))";
+  }
+}
+}  // namespace
+
+// The body is SoftmaxProgram's (core/providers/webgpu/math/softmax.cc) with
+// x = concat(a, b) + mask read element by element, and the result written as
+// float16 into the a and b outputs. Row r of the scores is row
+// (r % rows_per_head) of head (r / rows_per_head) % heads of batch
+// r / (rows_per_head * heads); the mask row index uses the mask strides
+// (0 where the mask broadcasts).
+Status SplitMaskedSoftmaxProgram::GenerateShaderCode(ShaderHelper& shader) const {
+  shader.AddInput("a", ShaderUsage::UseUniform);
+  shader.AddInput("b", ShaderUsage::UseUniform);
+  shader.AddInput("mask", ShaderUsage::UseUniform);
+  shader.AddOutput("pa", ShaderUsage::UseUniform);
+  shader.AddOutput("pb", ShaderUsage::UseUniform);
+  const int c = components_;
+  const std::string vt = VecType(c);
+  const char* lane[4] = {"x", "y", "z", "w"};
+
+  auto& impl = shader.AdditionalImplementation();
+  impl << "alias x_value_t = " << vt << ";\n"
+       << "var<workgroup> row_max_shared : x_value_t;\n"
+       << "var<workgroup> row_sum_shared : x_value_t;\n"
+       << "var<workgroup> thread_max_scalar_shared : array<f32, " << wg_ << ">;\n"
+       << "var<workgroup> thread_sum_scalar_shared : array<f32, " << wg_ << ">;\n"
+       << "fn load_one(row : u32, mask_row : u32, e : u32) -> f32 {\n"
+       << "  var s : f32;\n"
+       << "  if (e < uniforms.cols_a) {\n"
+       << "    s = a[row * uniforms.cols_a + e];\n"
+       << "  } else {\n"
+       << "    s = b[row * uniforms.cols_b + (e - uniforms.cols_a)];\n"
+       << "  }\n"
+       << "  return s + mask[mask_row * (uniforms.cols_a + uniforms.cols_b) + e];\n"
+       << "}\n"
+       << "fn get_value(row : u32, mask_row : u32, col : u32) -> x_value_t {\n"
+       << "  let e = col * " << c << "u;\n";
+  if (c == 1) {
+    impl << "  return load_one(row, mask_row, e);\n";
+  } else {
+    impl << "  return x_value_t(";
+    for (int j = 0; j < c; j++) impl << (j ? ", " : "") << "load_one(row, mask_row, e + " << j << "u)";
+    impl << ");\n";
+  }
+  impl << "}\n"
+       << "fn store_one(row : u32, e : u32, p : f32) {\n"
+       << "  if (e < uniforms.cols_a) {\n"
+       << "    pa[row * uniforms.cols_a + e] = f16(p);\n"
+       << "  } else {\n"
+       << "    pb[row * uniforms.cols_b + (e - uniforms.cols_a)] = f16(p);\n"
+       << "  }\n"
+       << "}\n";
+
+  auto& body = shader.MainFunctionBody();
+  body << "  let lindex = local_idx;\n"
+       << "  const wg = " << wg_ << "u;\n"
+       << "  let row = workgroup_idx;\n"
+       << "  let cols = uniforms.packed_cols;\n"
+       << "  let r_in_head = row % uniforms.rows_per_head;\n"
+       << "  let head = (row / uniforms.rows_per_head) % uniforms.heads;\n"
+       << "  let batch = row / (uniforms.rows_per_head * uniforms.heads);\n"
+       << "  let mask_row = batch * uniforms.mask_batch_stride + head * uniforms.mask_head_stride + r_in_head * uniforms.mask_row_stride;\n"
+       << "  var thread_max = f32(-3.4028234663852886e+38f);\n"
+       << "  var thread_sum = f32(0.0);\n"
+       << "  for (var col = lindex; col < cols; col += wg) {\n"
+       << "    let value = get_value(row, mask_row, col);\n"
+       << "    let value_max = f32(" << MaxOf("value", c) << ");\n"
+       << "    let new_max = max(thread_max, value_max);\n"
+       << "    let shifted_exp = exp(value - x_value_t(new_max));\n"
+       << "    thread_sum = thread_sum * exp(thread_max - new_max) + f32(" << SumVector("shifted_exp", c) << ");\n"
+       << "    thread_max = new_max;\n"
+       << "  }\n"
+       << "  thread_max_scalar_shared[lindex] = thread_max;\n"
+       << "  thread_sum_scalar_shared[lindex] = thread_sum;\n"
+       << "  workgroupBarrier();\n"
+       << "  for (var curr_size = wg >> 1; curr_size > 0; curr_size = curr_size >> 1) {\n"
+       << "    if (lindex < curr_size) {\n"
+       << "      let rhs_max = thread_max_scalar_shared[lindex + curr_size];\n"
+       << "      let rhs_sum = thread_sum_scalar_shared[lindex + curr_size];\n"
+       << "      let lhs_max = thread_max_scalar_shared[lindex];\n"
+       << "      let lhs_sum = thread_sum_scalar_shared[lindex];\n"
+       << "      let merged_max = max(lhs_max, rhs_max);\n"
+       << "      thread_sum_scalar_shared[lindex] = lhs_sum * exp(lhs_max - merged_max) + rhs_sum * exp(rhs_max - merged_max);\n"
+       << "      thread_max_scalar_shared[lindex] = merged_max;\n"
+       << "    }\n"
+       << "    workgroupBarrier();\n"
+       << "  }\n"
+       << "  if (lindex == 0) {\n"
+       << "    row_max_shared = x_value_t(thread_max_scalar_shared[0]);\n"
+       << "    row_sum_shared = x_value_t(thread_sum_scalar_shared[0]);\n"
+       << "  }\n"
+       << "  workgroupBarrier();\n"
+       << "  for (var col = lindex; col < cols; col += wg) {\n"
+       << "    var value = exp(get_value(row, mask_row, col) - row_max_shared) / row_sum_shared;\n"
+       << "    value = max(value, x_value_t(0.0));\n";
+  if (c == 1) {
+    body << "    store_one(row, col, value);\n";
+  } else {
+    for (int j = 0; j < c; j++) body << "    store_one(row, col * " << c << "u + " << j << "u, value." << lane[j] << ");\n";
+  }
+  body << "  }\n";
+  return Status::OK();
+}
+
+Status SplitMaskedSoftmax::ComputeInternal(onnxruntime::webgpu::ComputeContext& context) const {
+  const Tensor* a = context.Input(0);
+  const Tensor* b = context.Input(1);
+  const Tensor* mask = context.Input(2);
+  const TensorShape& sa = a->Shape();
+  const TensorShape& sb = b->Shape();
+  const TensorShape& sm = mask->Shape();
+  if (sa.NumDimensions() != 4 || sb.NumDimensions() != 4 || sm.NumDimensions() != 4) {
+    return ORT_MAKE_STATUS(ONNXRUNTIME, INVALID_ARGUMENT, "SplitMaskedSoftmax: inputs must be 4-D");
+  }
+  for (size_t i = 0; i < 3; i++) {
+    if (sa[i] != sb[i]) {
+      return ORT_MAKE_STATUS(ONNXRUNTIME, INVALID_ARGUMENT, "SplitMaskedSoftmax: scores_a and scores_b differ before the last axis");
+    }
+  }
+  const int64_t batch = sa[0], heads = sa[1], rows_per_head = sa[2];
+  const int64_t cols_a = sa[3], cols_b = sb[3], cols = cols_a + cols_b;
+  // Each part needs at least one column. The gemma12b graph always has one
+  // (the stable part holds the pad slot, the recent part this run's tokens);
+  // an empty part is a caller error, not a case to compute.
+  if (cols_a == 0 || cols_b == 0) {
+    return ORT_MAKE_STATUS(ONNXRUNTIME, INVALID_ARGUMENT,
+                           "SplitMaskedSoftmax: scores_a and scores_b must each have at least one column (got ",
+                           cols_a, " and ", cols_b, ")");
+  }
+  if (sm[3] != cols || (sm[0] != 1 && sm[0] != batch) || (sm[1] != 1 && sm[1] != heads) || (sm[2] != 1 && sm[2] != rows_per_head)) {
+    return ORT_MAKE_STATUS(ONNXRUNTIME, INVALID_ARGUMENT, "SplitMaskedSoftmax: mask ", sm.ToString(),
+                           " does not broadcast to the scores [", batch, ",", heads, ",", rows_per_head, ",", cols, "]");
+  }
+  Tensor* pa = context.Output(0, sa);
+  Tensor* pb = context.Output(1, sb);
+  const int64_t rows = batch * heads * rows_per_head;
+  if (rows == 0) {
+    return Status::OK();
+  }
+  // Scalar columns (not SoftmaxProgram's vector width of the whole row) and
+  // 64 threads. Thread i then reduces columns i, i +
+  // wg, ... whatever the row length, so a row's sums do not depend on how many
+  // columns the pass has: the extra columns of a k-token verify pass are
+  // masked (exp gives exactly 0) and come after the row's own columns. A
+  // vector width taken from the row length (1, 2 or 4) regrouped the columns
+  // and changed the sums, so a verify pass and one-token steps disagreed in
+  // the last bits (lowmem C1, scripts/lowmem-batchinv.html).
+  const int components = 1;
+  // One workgroup size for every row count (stock: 256 threads for one row).
+  const uint32_t wg = 64;
+  const uint32_t mask_rows = static_cast<uint32_t>(sm[2]);
+  const uint32_t mask_row_stride = sm[2] == 1 ? 0u : 1u;
+  const uint32_t mask_head_stride = sm[1] == 1 ? 0u : mask_rows;
+  const uint32_t mask_batch_stride = sm[0] == 1 ? 0u : static_cast<uint32_t>(sm[1]) * mask_rows;
+
+  SplitMaskedSoftmaxProgram program{wg, components};
+  program
+      .AddInputs({{a, ProgramTensorMetadataDependency::TypeAndRank},
+                  {b, ProgramTensorMetadataDependency::TypeAndRank},
+                  {mask, ProgramTensorMetadataDependency::TypeAndRank}})
+      .AddOutputs({{pa, ProgramTensorMetadataDependency::TypeAndRank}, {pb, ProgramTensorMetadataDependency::TypeAndRank}})
+      .CacheHint(std::to_string(components), std::to_string(wg))
+      .SetWorkgroupSize(wg)
+      .SetDispatchGroupSize(static_cast<uint32_t>(rows))
+      .AddUniformVariables({{static_cast<uint32_t>(cols_a)},
+                            {static_cast<uint32_t>(cols_b)},
+                            {static_cast<uint32_t>(cols / components)},
+                            {static_cast<uint32_t>(rows_per_head)},
+                            {static_cast<uint32_t>(heads)},
+                            {mask_batch_stride},
+                            {mask_head_stride},
+                            {mask_row_stride}});
+  return context.RunProgram(program);
+}
+
+}  // namespace webgpu
+}  // namespace contrib
+}  // namespace onnxruntime
diff --git a/onnxruntime/contrib_ops/webgpu/bert/split_masked_softmax.h b/onnxruntime/contrib_ops/webgpu/bert/split_masked_softmax.h
new file mode 100644
index 0000000..5c4eacd
--- /dev/null
+++ b/onnxruntime/contrib_ops/webgpu/bert/split_masked_softmax.h
@@ -0,0 +1,50 @@
+// Copyright (c) Microsoft Corporation. All rights reserved.
+// Licensed under the MIT License.
+
+#pragma once
+
+#include "core/providers/webgpu/program.h"
+#include "core/providers/webgpu/webgpu_kernel.h"
+
+namespace onnxruntime {
+namespace contrib {
+namespace webgpu {
+
+using namespace onnxruntime::webgpu;
+using onnxruntime::webgpu::ComputeContext;
+
+// Fork (Gemma 4 12B split KV cache, P5): one kernel for
+//   Concat(scores_a, scores_b, axis=-1) + mask -> Softmax(axis=-1) -> Cast(float16)
+//   -> Slice back into the a and b parts.
+// The arithmetic mirrors the WebGPU Softmax program (same workgroup size,
+// same vector width over the whole row, same online max/sum and reduction
+// order), so the probabilities equal the unfused ops' output.
+class SplitMaskedSoftmaxProgram final : public Program<SplitMaskedSoftmaxProgram> {
+ public:
+  SplitMaskedSoftmaxProgram(uint32_t wg, int components) : Program{"SplitMaskedSoftmax"}, wg_{wg}, components_{components} {}
+
+  Status GenerateShaderCode(ShaderHelper& sh) const override;
+
+  WEBGPU_PROGRAM_DEFINE_UNIFORM_VARIABLES({"cols_a", ProgramUniformVariableDataType::Uint32},
+                                          {"cols_b", ProgramUniformVariableDataType::Uint32},
+                                          {"packed_cols", ProgramUniformVariableDataType::Uint32},
+                                          {"rows_per_head", ProgramUniformVariableDataType::Uint32},
+                                          {"heads", ProgramUniformVariableDataType::Uint32},
+                                          {"mask_batch_stride", ProgramUniformVariableDataType::Uint32},
+                                          {"mask_head_stride", ProgramUniformVariableDataType::Uint32},
+                                          {"mask_row_stride", ProgramUniformVariableDataType::Uint32});
+
+ private:
+  uint32_t wg_;
+  int components_;
+};
+
+class SplitMaskedSoftmax final : public WebGpuKernel {
+ public:
+  SplitMaskedSoftmax(const OpKernelInfo& info) : WebGpuKernel(info) {}
+  Status ComputeInternal(ComputeContext& context) const override;
+};
+
+}  // namespace webgpu
+}  // namespace contrib
+}  // namespace onnxruntime
diff --git a/onnxruntime/contrib_ops/webgpu/quantization/dp4a_matmul_batched.wgsl.template b/onnxruntime/contrib_ops/webgpu/quantization/dp4a_matmul_batched.wgsl.template
new file mode 100644
index 0000000..c293842
--- /dev/null
+++ b/onnxruntime/contrib_ops/webgpu/quantization/dp4a_matmul_batched.wgsl.template
@@ -0,0 +1,138 @@
+// Copyright (c) Microsoft Corporation. All rights reserved.
+// Licensed under the MIT License.
+
+// DP4A MatMulNBits for 1 <= M <= 16 rows (int8 activations), on GPUs where
+// one-token steps take the DP4A path: one-token decode steps (M = 1) and
+// short multi-token passes such as a speculative verify pass (M = 2..16).
+// A is quantized by DP4AMatMulQuantizeProgram first, per row and per
+// 128-element block, so each row's int8 values do not depend on M.
+//
+// Row invariance: a row gets the same bits for every M.
+//   - One pipeline serves every M (M is a uniform, not in the cache key).
+//   - The rows of a row tile are a runtime loop, so every row runs the same
+//     instructions, and a row's sums never depend on the other rows.
+//   - The summation order of a row is fixed:
+//       lane l of k_lanes owns the 32-element K chunks kv = l, l + k_lanes, ...;
+//       per chunk: acc_l += SDP8AI(a, b, a1, b1, scale_a * scale_b) (the
+//       integer dot products are exact);
+//       output = 0; output += acc_l for l = 0 .. k_lanes - 1; then + bias.
+//
+// Speed: one workgroup computes up to tile_rows rows for cols_per_wg columns;
+// each B chunk is read and converted to int8 once for all rows of the tile.
+//
+// Requirements (checked on the host): n_bits is 4 or 8, and the conditions of
+// CanApplyDP4AMatrixMatMulNBits.
+
+#param n_bits
+#param has_zero_points
+#param has_bias
+#param output_type_i32
+#param tile_rows
+#param reduce_rows
+#param cols_per_thread
+#param col_groups
+#param k_lanes
+
+#use .getByOffset .setByOffset
+
+#include "quantization/dp4a_matmul_common.wgsl.template"
+
+const cols_per_wg = cols_per_thread * col_groups;
+const wg_threads = col_groups * k_lanes;
+
+// Lane sums for the final reduction: [row][column slot][lane].
+var<workgroup> partials: array<array<output_element_t, k_lanes>, reduce_rows * cols_per_wg>;
+
+$MAIN {
+  let tiles_per_batch = uniforms.num_N_tile * uniforms.num_M_tile;
+  if (workgroup_idx >= tiles_per_batch * uniforms.batch_count) {
+    return;
+  }
+  let batch = workgroup_idx / tiles_per_batch;
+  let m_tile = (workgroup_idx % tiles_per_batch) / uniforms.num_N_tile;
+  let n_base = (workgroup_idx % uniforms.num_N_tile) * cols_per_wg;
+  let row0 = m_tile * uniforms.rows_per_tile;
+  let rows = min(uniforms.rows_per_tile, uniforms.M - row0);
+  // Consecutive threads take consecutive K lanes of one column group.
+  let lane = local_idx % k_lanes;
+  let group = local_idx / k_lanes;
+  let col0 = n_base + group * cols_per_thread;
+  let K128 = uniforms.K / 128;
+  let a_base = batch * uniforms.M * uniforms.K16 + row0 * uniforms.K16;
+  let scale_a_base = batch * uniforms.M * K128 + row0 * K128;
+
+  var acc: array<array<output_element_t, cols_per_thread>, tile_rows>;
+
+  for (var k_offset = lane; k_offset < uniforms.K32; k_offset += k_lanes) {
+    // k_offset covers 32 values of k.
+    let block_idx = k_offset * 32 / uniforms.block_size;
+    var own_bs: array<vec4<u32>, cols_per_thread>;
+    var own_b1s: array<vec4<u32>, cols_per_thread>;
+    var scale_bs: array<output_element_t, cols_per_thread>;
+#if has_zero_points && n_bits == 8
+    var zeros: array<i32, cols_per_thread>;
+#endif
+    for (var c = 0u; c < cols_per_thread; c++) {
+      let b_global = min(col0 + c, uniforms.N - 1);
+      let b_offset = b_global * uniforms.K32 + k_offset;
+      scale_bs[c] = scales_b.getByOffset(b_global * uniforms.K / uniforms.block_size + block_idx);
+      let zero = mm_read_zero(b_global, block_idx, uniforms.N, uniforms.zero_blocks_per_col);
+#if n_bits == 4
+      let b_value = b.getByOffset(b_offset);
+      own_bs[c] = DequantizedFrom4BitsTo8Bits(b_value.xy, zero);
+      own_b1s[c] = DequantizedFrom4BitsTo8Bits(b_value.zw, zero);
+#elif n_bits == 8
+      own_bs[c] = AlignWithZeroPoint(b.getByOffset(b_offset * 2));
+      own_b1s[c] = AlignWithZeroPoint(b.getByOffset(b_offset * 2 + 1));
+#if has_zero_points
+      zeros[c] = zero;
+#endif
+#endif
+    }
+    // Runtime loop over the rows of the tile: the same instructions for every row.
+    for (var m = 0u; m < rows; m++) {
+      let a_offset = a_base + m * uniforms.K16 + k_offset * 2;
+      let own_a = a.getByOffset(a_offset);
+      let own_a1 = a.getByOffset(a_offset + 1);
+      let own_scale_a = scales_a.getByOffset(scale_a_base + m * K128 + k_offset / 4);
+      for (var c = 0u; c < cols_per_thread; c++) {
+#if has_zero_points && n_bits == 8
+        acc[m][c] += SDP8AI(own_a, own_bs[c], own_a1, own_b1s[c], own_scale_a * scale_bs[c], zeros[c]);
+#else
+        acc[m][c] += SDP8AI(own_a, own_bs[c], own_a1, own_b1s[c], own_scale_a * scale_bs[c]);
+#endif
+      }
+    }
+  }
+
+  // Sum the k_lanes lane sums of every (row, column) in lane order,
+  // reduce_rows rows at a time.
+  for (var mb = 0u; mb < tile_rows; mb += reduce_rows) {
+    for (var r = 0u; r < reduce_rows; r++) {
+      if (mb + r < rows) {
+        for (var c = 0u; c < cols_per_thread; c++) {
+          partials[r * cols_per_wg + group * cols_per_thread + c][lane] = acc[mb + r][c];
+        }
+      }
+    }
+    workgroupBarrier();
+    for (var t = local_idx; t < reduce_rows * cols_per_wg; t += wg_threads) {
+      let r = t / cols_per_wg;
+      let col = n_base + t % cols_per_wg;
+      if (mb + r < rows && col < uniforms.N) {
+        var output_value = output_element_t(0);
+        for (var l = 0u; l < k_lanes; l++) {
+          output_value += partials[t][l];
+        }
+        let output_idx = batch * uniforms.M * uniforms.N + (row0 + mb + r) * uniforms.N + col;
+#if has_bias
