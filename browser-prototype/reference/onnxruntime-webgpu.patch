+// Batched-int4 fork: multi-query GQA decode for 1 <= sequence_length <= 16.
+// Replaces FlashAttentionDecodeQKV + VxReduce there, for one-token steps too,
+// so that a k-token verify pass and k one-token steps give each query row the
+// same bits (the stock kernel changes its tiling and summation order with the
+// row count). K/V tiles are read once per KV head instead of once per query
+// head and query tile.
+bool CanApplyFlashAttentionDecodeGQA(const WebgpuAttentionParameters& parameters, const Tensor* attention_bias,
+                                     const Tensor* head_sink, bool use_paged_kv_cache,
+                                     bool kv_cache_quantization_enabled, bool use_seqlens_q,
+                                     bool use_indirect_dispatch) {
+  return !use_paged_kv_cache && !kv_cache_quantization_enabled && !use_seqlens_q && !use_indirect_dispatch &&
+         attention_bias == nullptr && head_sink == nullptr &&
+         parameters.qkv_format_ != Q_K_V_BNSH && parameters.is_unidirectional_ &&
+         parameters.sequence_length_ >= 1 && parameters.sequence_length_ <= 16 &&
+         parameters.v_head_size_ == parameters.head_size_ && parameters.head_size_ % 4 == 0 &&
+         parameters.head_size_ <= 128 && parameters.is_gqa_ && parameters.n_reps >= 1 &&
+         parameters.num_heads_ == parameters.n_reps * parameters.kv_num_heads_ &&
+         parameters.total_sequence_length_ > 0;
+}
+
+Status ComputeFlashAttentionDecodeGQA(onnxruntime::webgpu::ComputeContext& context, const Tensor* Q,
+                                      const Tensor* present_key, const Tensor* present_value, const Tensor* seqlen_k,
+                                      Tensor* output, const WebgpuAttentionParameters& parameters,
+                                      uint32_t present_sequence_length) {
+  constexpr uint32_t tile_size = 64;
+  constexpr uint32_t row_chunk = 16;
+  constexpr uint32_t workgroup_size = 128;
+  const bool use_seqlen_k = seqlen_k != nullptr;
+  const uint32_t head_size_vec = static_cast<uint32_t>(parameters.head_size_ / 4);
+  const uint32_t S = static_cast<uint32_t>(parameters.sequence_length_);
+  const uint32_t B = static_cast<uint32_t>(parameters.batch_size_);
+  const uint32_t num_heads = static_cast<uint32_t>(parameters.num_heads_);
+  const uint32_t kv_num_heads = static_cast<uint32_t>(parameters.kv_num_heads_);
+  const uint32_t n_reps = static_cast<uint32_t>(parameters.n_reps);
+  const uint32_t total = static_cast<uint32_t>(parameters.total_sequence_length_);
+  const uint32_t num_tiles = (total + tile_size - 1) / tile_size;
+  const float alpha = parameters.scale_ == 0.0f ? 1.f / sqrt(static_cast<float>(parameters.head_size_))
+                                                : parameters.scale_;
+  const int64_t rows = static_cast<int64_t>(B) * num_heads * S;
+
+  Tensor metadata = context.CreateGPUTensor(DataTypeImpl::GetType<float>(), TensorShape({rows, static_cast<int64_t>(num_tiles), 2}));
+  Tensor partials = context.CreateGPUTensor(DataTypeImpl::GetType<float>(),
+                                            TensorShape({rows, static_cast<int64_t>(num_tiles), static_cast<int64_t>(parameters.head_size_)}));
+
+  FlashAttentionDecodeGQAProgram program{head_size_vec, row_chunk, tile_size, use_seqlen_k};
+  program.AddInputs({{Q, ProgramTensorMetadataDependency::TypeAndRank, 4},
+                     {present_key, ProgramTensorMetadataDependency::TypeAndRank, 4},
+                     {present_value, ProgramTensorMetadataDependency::TypeAndRank, 4}});
+  if (use_seqlen_k) {
+    program.AddInput({seqlen_k, ProgramTensorMetadataDependency::None});
+  }
+  program.AddOutputs({{&partials, ProgramTensorMetadataDependency::Rank, 4},
+                      {&metadata, ProgramTensorMetadataDependency::Rank, 2}});
+  // The cache key leaves out the sequence length on purpose: every row count
+  // runs the same pipeline.
+  program.SetDispatchGroupSize(B * kv_num_heads * num_tiles)
+      .SetWorkgroupSize(workgroup_size)
+      .CacheHint(head_size_vec, row_chunk, tile_size, use_seqlen_k)
+      .AddUniformVariables({{S},
+                            {total},
+                            {present_sequence_length},
+                            {n_reps},
+                            {num_heads},
+                            {kv_num_heads},
+                            {B},
+                            {num_tiles},
+                            {alpha}});
+  ORT_RETURN_IF_ERROR(context.RunProgram(program));
+
+  const uint32_t output_count = static_cast<uint32_t>(rows) * head_size_vec;
+  FlashAttentionDecodeGQAReduceProgram reduce{tile_size, use_seqlen_k};
+  reduce.AddInputs({{&partials, ProgramTensorMetadataDependency::Rank, 4},
+                    {&metadata, ProgramTensorMetadataDependency::Rank, 2}});
+  if (use_seqlen_k) {
+    reduce.AddInput({seqlen_k, ProgramTensorMetadataDependency::None});
+  }
+  reduce.AddOutput({output, ProgramTensorMetadataDependency::TypeAndRank, 4});
+  reduce.SetDispatchGroupSize((output_count + 63) / 64)
+      .SetWorkgroupSize(64)
+      .CacheHint(tile_size, use_seqlen_k)
+      .AddUniformVariables({{output_count},
+                            {head_size_vec},
+                            {S},
+                            {total},
+                            {num_heads},
+                            {num_tiles}});
+  return context.RunProgram(reduce);
+}
