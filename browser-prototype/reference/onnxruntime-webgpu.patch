+Status DP4AMatMulNBitsBatchedProgram::GenerateShaderCode(ShaderHelper& shader) const {
+  const auto& a = shader.AddInput("input_a", ShaderUsage::UseUniform);
+  const auto& scales_a = shader.AddInput("scales_a", ShaderUsage::UseUniform);
+  const auto& b = shader.AddInput("input_b", ShaderUsage::UseUniform);
+  const auto& scales_b = shader.AddInput("scales_b", ShaderUsage::UseUniform);
+  if (has_zero_points_) {
+    shader.AddInput("zero_points", ShaderUsage::UseUniform);
+  }
+  if (has_bias_) {
+    shader.AddInput("bias", ShaderUsage::UseUniform);
+  }
+  const auto& output = shader.AddOutput("output", ShaderUsage::UseUniform | ShaderUsage::UseElementTypeAlias);
+  ORT_ENFORCE(nbits_ == 4 || nbits_ == 8, "DP4AMatMulNBitsBatched supports 4 and 8 bits.");
+  ORT_ENFORCE(WorkgroupSizeX() == col_groups_ * k_lanes_, "workgroup size must be col_groups * k_lanes.");
+  return WGSL_TEMPLATE_APPLY(shader, "quantization/dp4a_matmul_batched.wgsl.template",
+                             WGSL_TEMPLATE_PARAMETER(col_groups, col_groups_),
+                             WGSL_TEMPLATE_PARAMETER(cols_per_thread, cols_per_thread_),
+                             WGSL_TEMPLATE_PARAMETER(has_bias, has_bias_),
+                             WGSL_TEMPLATE_PARAMETER(has_zero_points, has_zero_points_),
+                             WGSL_TEMPLATE_PARAMETER(k_lanes, k_lanes_),
+                             WGSL_TEMPLATE_PARAMETER(n_bits, nbits_),
+                             WGSL_TEMPLATE_PARAMETER(output_type_i32, true),
+                             WGSL_TEMPLATE_PARAMETER(reduce_rows, reduce_rows_),
+                             WGSL_TEMPLATE_PARAMETER(tile_rows, tile_rows_),
+                             WGSL_TEMPLATE_VARIABLE(a, a),
+                             WGSL_TEMPLATE_VARIABLE(b, b),
+                             WGSL_TEMPLATE_VARIABLE(output, output),
+                             WGSL_TEMPLATE_VARIABLE(scales_a, scales_a),
+                             WGSL_TEMPLATE_VARIABLE(scales_b, scales_b));
+}
+
+Status ApplyDP4AMatMulNBitsBatched(const Tensor* a, const Tensor* b, const Tensor* scales,
+                                   const Tensor* zero_points, const Tensor* bias,
+                                   uint32_t batch_count,
+                                   uint32_t M,
+                                   uint32_t N,
+                                   uint32_t K,
+                                   uint32_t block_size,
+                                   uint32_t zero_blocks_per_col,
+                                   uint32_t nbits,
+                                   onnxruntime::webgpu::ComputeContext& context,
+                                   Tensor* y) {
+  constexpr uint32_t kVec4Components = 4;
+  constexpr uint32_t kU32Components = 4;
+  constexpr uint32_t kBlockSizeA = 128;
+  // A: the same quantize program and shapes as ApplyDP4AMatrixMatMulNBits.
+  // It works per 128-element block, so each row's int8 values and scales do
+  // not depend on M.
+  DP4AMatMulQuantizeProgram quantize_program;
+  quantize_program.SetWorkgroupSize(64);
+  const uint32_t quantize_tile_size = 64 * kVec4Components;
