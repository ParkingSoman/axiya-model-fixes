+  shader.AddInput("beta", ShaderUsage::UseUniform);
+  shader.AddOutput("output", ShaderUsage::UseUniform | ShaderUsage::UseValueTypeAlias);         // vec4
+  shader.AddOutput("present_state", ShaderUsage::UseUniform | ShaderUsage::UseValueTypeAlias);  // vec4
+  shader.AdditionalImplementation()
+      << "const D: u32 = 128u;\n"
+         "const D4: u32 = 32u;\n"
+         "const NT: u32 = 32u;\n"  // threads
+         "var<workgroup> red_ret: array<vec4<f32>, NT * 2u>;\n"
+         "var<workgroup> red_pre: array<vec4<f32>, NT * 2u>;\n"
+         "var<workgroup> red_kq: array<f32, NT>;\n"
+         "var<workgroup> bcast: array<vec4<f32>, 2u>;\n";
+  auto& b = shader.MainFunctionBody();
+  b << R"WGSL(
+  let H = uniforms.num_heads;
+  let bh = workgroup_idx / 16u;          // 16 tiles of 8 value columns per head
+  let tile = workgroup_idx % 16u;
+  let batch = bh / H;
+  let h = bh % H;
+  let t = local_idx;
+  let col4 = tile * 2u;                  // first vec4 column
+  let slot_size = uniforms.batch_size * H * D * D4;
+)WGSL";
+  if (has_state_window_) {
